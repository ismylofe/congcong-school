  "knowledge_summary": [
    {
      "point": "除法算式(整除)",
      "core_concept": "把東西平分成幾份，或每幾個分一份，都可以用除法記錄。被除數 ÷ 除數 = 商。除法和乘法有關係，可以用乘法驗算：除數 × 商 = 被除數。",
      "key_formula": "被除數 ÷ 除數 = 商；除數 × 商 = 被除數",
      "common_mistakes": [
        "把被除數和除數的位置寫反。",
        "兩步驟的題目只算了一步。"
      ],
      "tips": "想一想「幾乘以幾會等於被除數」，用九九乘法找商。"
    },
    {
      "point": "認識餘數",
      "core_concept": "分東西時如果分完還剩一些、不夠再分一份，剩下的就是餘數。餘數一定要比除數小；如果餘數比除數大或一樣大，表示還可以再分。",
      "key_formula": "被除數 = 除數 × 商 + 餘數；餘數 < 除數",
      "common_mistakes": [
        "餘數比除數大還沒發現。",
        "驗算時忘了加上餘數。"
      ],
      "tips": "算完檢查兩件事：除數 × 商 + 餘數等不等於被除數？餘數有沒有比除數小？"
    },
    {
      "point": "除法直式計算",
      "core_concept": "二位數除以一位數（商是一位數）的直式：想除數乘以多少最接近、但不超過被除數，那個數就是商；再用被除數減去除數 × 商，得到餘數。",
      "key_formula": "找最大的商：除數 × 商 ≤ 被除數",
      "common_mistakes": [
        "商估得太小，餘數比除數大。",
        "商估得太大，除數 × 商比被除數大，不夠減。"
      ],
      "tips": "試商後先看能不能減，再看餘數是不是比除數小。"
    },
