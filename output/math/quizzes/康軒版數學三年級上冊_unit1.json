  "knowledge_summary": [
    {
      "point": "數到10000",
      "core_concept": "10個1是10，10個10是100，10個100是1000，10個1000是10000（一萬）。四位數由左到右是千位、百位、十位、個位，每個位置的數字代表幾個千、幾個百、幾個十、幾個一。",
      "key_formula": "10個100＝1000；10個1000＝10000",
      "common_mistakes": [
        "讀寫數時漏掉中間的0，例如把四千零五寫成450。",
        "把9999再多1誤寫成1000。"
      ],
      "tips": "用位值表把每一位的數字填進去，再從左到右讀出來。"
    },
    {
      "point": "使用錢幣",
      "core_concept": "錢幣有1元、5元、10元、50元、100元、500元、1000元。算總共多少錢時，可以先把同樣面額的錢幣合起來，再加起來；付錢時用大面額的錢幣，張數會比較少。",
      "key_formula": "總錢數＝各面額 × 張數，再相加",
      "common_mistakes": [
        "忘記把面額乘以張數就直接相加。",
        "換錢時沒有盡量用大面額。"
      ],
      "tips": "先從最大的面額開始算，再往小的面額加。"
    },
    {
      "point": "比大小",
      "core_concept": "比較兩個四位數的大小，先比千位，千位一樣再比百位，依序比下去，第一個不一樣的位置就能決定大小。大的數用＞，小的數用＜。",
      "key_formula": "由左到右，逐位比較",
      "common_mistakes": [
        "從個位開始比。",
        "把＞和＜的開口方向弄反。"
      ],
      "tips": "開口朝向大的數；從最左邊的位數開始比。"
    },
